{
  "name": "code-to-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/studio",
    "packages/themes",
    "packages/ui"
  ],
  "engines": {
    "node": ">=24.7.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "studio": "npm run studio --workspace=@code-to-video/studio",
    "render": "npm run render --workspace=@code-to-video/studio",
    "compositions": "npm run compositions --workspace=@code-to-video/studio",
    "browser:ensure": "npm run browser:ensure --workspace=@code-to-video/studio",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/qa/tsconfig.json",
    "test": "npm run test --workspaces && npm run test:qa",
    "test:qa": "node --experimental-strip-types --test tests/reliability/*.test.ts",
    "qa:fonts": "node --experimental-strip-types scripts/qa/cli.ts fonts",
    "qa:layout": "node --experimental-strip-types scripts/qa/cli.ts layout",
    "qa:visual:capture": "node --experimental-strip-types scripts/qa/cli.ts capture",
    "qa:visual:compare": "node --experimental-strip-types scripts/qa/cli.ts compare",
    "qa:visual:approve": "node --experimental-strip-types scripts/qa/cli.ts approve",
    "qa:themes": "node --experimental-strip-types scripts/qa/cli.ts themes",
    "qa:render": "node --experimental-strip-types scripts/qa/cli.ts render",
    "qa:all": "node --experimental-strip-types scripts/qa/cli.ts all",
    "qa:surfaces": "node --experimental-strip-types scripts/qa/surfaces.ts",
    "qa:island": "node --experimental-strip-types scripts/qa/island.ts",
    "qa:charts": "node --experimental-strip-types scripts/qa/charts.ts",
    "qa:clay": "node --experimental-strip-types scripts/qa/clay.ts",
    "check": "npm run typecheck && npm test && npm run test:studio-props",
    "test:frames": "node scripts/check-frames.mjs",
    "test:themes": "node scripts/check-themes.mjs",
    "test:studio-props": "node scripts/check-studio-props.mjs",
    "test:components": "node scripts/check-components.mjs",
    "render:components:aurora": "npm run render:components:aurora --workspace=@code-to-video/studio",
    "render:components:ember": "npm run render:components:ember --workspace=@code-to-video/studio",
    "render:aurora": "npm run render:aurora --workspace=@code-to-video/studio",
    "render:ember": "npm run render:ember --workspace=@code-to-video/studio",
    "qa:cinematic": "node --experimental-strip-types scripts/qa/cinematic.ts"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  }
}
